<UserControl x:Class="StockFlow.UI.Views.StockMovementEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="uk-UA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
        <Style x:Key="EditorField" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,16,12"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="24" Style="{StaticResource FormPanel}" HorizontalAlignment="Left" Width="560">
            <StackPanel>
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <WrapPanel>
                        <StackPanel Width="250" Style="{StaticResource EditorField}">
                            <TextBlock Text="Номер (автоматичний)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NumberBox" Text="{Binding Number, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource InputBox}" AutomationProperties.Name="Номер накладної"/>
                        </StackPanel>
                        <StackPanel Width="205" Style="{StaticResource EditorField}">
                            <TextBlock Text="Дата" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding Date}" Height="40" AutomationProperties.Name="Дата накладної"/>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Style="{StaticResource EditorField}">
                        <TextBlock Text="Тип" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding Types}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedType}" AutomationProperties.Name="Тип накладної"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource EditorField}">
                        <TextBlock Text="Товар" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding Products}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProduct}" AutomationProperties.Name="Товар накладної"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource EditorField}">
                        <TextBlock Text="Склад" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedWarehouse}" AutomationProperties.Name="Склад накладної"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource EditorField}">
                        <TextBlock Text="Кількість" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Кількість товару"/>
                    </StackPanel>
                    <StackPanel x:Name="SupplierField" Style="{StaticResource EditorField}"
                                Visibility="{Binding ShowsSupplier, Converter={StaticResource VisibleIfTrue}}">
                        <TextBlock Text="Постачальник (для надходження)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedSupplier}" AutomationProperties.Name="Постачальник накладної"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource EditorField}">
                        <TextBlock Text="Відповідальна особа" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ResponsibleBox" Text="{Binding ResponsibleName, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource InputBox}" AutomationProperties.Name="Відповідальна особа"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource EditorField}">
                        <TextBlock Text="Примітка" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Примітка накладної"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SaveErrorText" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource ErrorTextBrush}" Margin="0,4,0,12"
                           AutomationProperties.LiveSetting="Polite"/>
                <WrapPanel>
                    <Button Content="Зберегти" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                    <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
