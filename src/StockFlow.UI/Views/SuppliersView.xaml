<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StockFlow.UI.Views.SuppliersView"
    Loaded="OnLoaded"
    Background="{StaticResource BackgroundBrush}"
    Foreground="{StaticResource PrimaryTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PageHeader}">
            <TextBlock Text="Постачальники" Style="{StaticResource PageHeaderText}"/>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right"
                    Content="+ Додати постачальника"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenEditorCommand}"
                    Margin="16,0,0,0"
                    Visibility="{Binding CanManage, Converter={StaticResource VisibleIfTrue}}"/>
                <Button DockPanel.Dock="Right"
                    Content="&#xE72C;"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ReloadCommand}"
                    Padding="10,0"
                    ToolTip="Оновити список"
                    AutomationProperties.Name="Оновити постачальників"/>
                <TextBox x:Name="SearchBox"
                    Style="{StaticResource SearchBox}"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,12,0"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Tag="Пошук за назвою або контактом..."
                    ToolTip="Пошук за назвою, телефоном або електронною поштою"
                    AutomationProperties.Name="Пошук постачальників"/>
            </DockPanel>
            <Border Grid.Row="2"
                Style="{StaticResource FormPanel}"
                Background="{StaticResource BackgroundBrush}"
                Padding="16"
                Margin="0,0,0,12"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibleIfTrue}}">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}"
                        FontWeight="SemiBold"
                        FontSize="15"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,10" Width="225">
                            <TextBlock Text="Назва *" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputBox}"
                                Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="100"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10" Width="180">
                            <TextBlock Text="Телефон" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputBox}"
                                Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="30"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10" Width="245">
                            <TextBlock Text="Email" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputBox}"
                                Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="100"/>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                            Content="Зберегти"
                            Command="{Binding AddCommand}"
                            Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SecondaryButton}"
                            Content="Скасувати"
                            Command="{Binding CancelEditorCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Завантаження..."
                    FontStyle="Italic"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfTrue}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Grid Grid.Row="4">
                <DataGrid Style="{StaticResource ListDataGrid}"
                    ItemsSource="{Binding Suppliers}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="1.4*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                        <DataGridTemplateColumn x:Name="ActionsColumn"
                            Header="Дії"
                            HeaderStyle="{StaticResource ActionsColumnHeader}"
                            Width="Auto"
                            MinWidth="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIfTrue}}">
                                        <Button Content="Редагувати"
                                            Style="{StaticResource DirectoryActionLink}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                        <TextBlock Text="·"
                                            Foreground="{StaticResource AccentTextBrush}"
                                            VerticalAlignment="Center"
                                            Margin="6,0"/>
                                        <Button Content="Видалити"
                                            Style="{StaticResource DirectoryActionLink}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Постачальників не знайдено"
                    FontStyle="Italic"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIfTrue}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
