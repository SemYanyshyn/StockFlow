<UserControl x:Class="StockFlow.UI.Views.StockBalancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StockFlow.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockBalancesViewModel}">

  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageHeader}">
      <TextBlock Text="StockFlow — Залишки" Style="{StaticResource PageHeaderText}"/>
    </Border>

    <Grid Grid.Row="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="240"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 Style="{StaticResource SearchBox}"
                 Tag="Пошук за назвою товару..."
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <ComboBox Grid.Column="2"
                  Style="{StaticResource InputComboBox}"
                  Tag="Склад:"
                  ItemsSource="{Binding Warehouses}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedWarehouse}"/>

        <ToggleButton Grid.Column="4"
                      Style="{StaticResource CriticalFilterToggle}"
                      IsChecked="{Binding OnlyCritical}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x26A0; " FontWeight="Bold"/>
            <TextBlock Text="Тільки критичні залишки"/>
          </StackPanel>
        </ToggleButton>
      </Grid>

      <DataGrid Grid.Row="1"
                Style="{StaticResource ListDataGrid}"
                ItemsSource="{Binding FilteredRows}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLow}" Value="True">
                <Setter Property="Background" Value="{StaticResource CriticalRowBackgroundBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Товар" Width="1.5*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource CriticalTextBrush}"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Склад" Width="1.2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding WarehouseName}" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource CriticalTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Поточний залишок" Width="160">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding QuantityDisplay}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource CriticalTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Мін. норма" Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding MinThresholdDisplay}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource CriticalTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Статус" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border CornerRadius="4"
                        BorderThickness="1"
                        Padding="12,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}"/>
                      <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                          <Setter Property="Background" Value="{StaticResource CriticalBackgroundBrush}"/>
                          <Setter Property="BorderBrush" Value="{StaticResource CriticalBorderBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLow}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource CriticalTextBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>