<Window x:Class="StockFlow.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockFlow.UI.ViewModels"
        xmlns:views="clr-namespace:StockFlow.UI.Views"
        Title="StockFlow" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate DataType="{x:Type vm:WarehousesViewModel}">
            <views:WarehousesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockBalancesViewModel}">
            <views:StockBalancesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockMovementsViewModel}">
            <views:StockMovementsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" VerticalAlignment="Stretch">
            <TextBlock Text="StockFlow" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="24,32,0,32"/>
            <Button Style="{StaticResource SidebarButton}" Content="Товари" Command="{Binding NavigateProductsCommand}" Margin="16,0,0,4"/>
            <Button Style="{StaticResource SidebarButton}" Content="Категорії" Command="{Binding NavigateCategoriesCommand}" Margin="16,0,0,4"/>
            <Button Style="{StaticResource SidebarButton}" Content="Накладні" Command="{Binding NavigateMovementsCommand}" Margin="16,0,0,4"/>
            <Button Style="{StaticResource SidebarButton}" Content="Залишки" Command="{Binding NavigateStockCommand}" Margin="16,0,0,4"/>
            <Button Style="{StaticResource SidebarButton}" Content="Склади" Command="{Binding NavigateWarehousesCommand}" Margin="16,0,0,4"/>
            <Button Style="{StaticResource SidebarButton}" Content="Звітність" Command="{Binding NavigateReportsCommand}" Margin="16,0,0,4"/>
            <Button Style="{StaticResource SidebarButton}" Content="Користувачі"
                    Command="{Binding NavigateUsersCommand}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="16,0,0,4"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" Padding="0">
            <ContentControl Content="{Binding Navigation.CurrentView}"/>
        </Border>
    </Grid>
</Window>
