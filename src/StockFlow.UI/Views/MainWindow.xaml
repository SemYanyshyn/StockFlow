<Window x:Class="StockFlow.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockFlow.UI.ViewModels"
        xmlns:views="clr-namespace:StockFlow.UI.Views"
        xmlns:converters="clr-namespace:StockFlow.UI.Converters"
        Title="StockFlow" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ActiveSectionConverter x:Key="ActiveSectionConverter"/>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <views:CategoriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WarehousesViewModel}">
            <views:WarehousesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockBalancesViewModel}">
            <views:StockBalancesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockMovementsViewModel}">
            <views:StockMovementsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" VerticalAlignment="Stretch">
            <TextBlock Text="StockFlow" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="24,32,0,32"/>
            <TextBlock Style="{StaticResource SidebarCaption}" Text="Розділи"/>
            <Button Style="{StaticResource SidebarButton}" Content="Товари" Command="{Binding NavigateProductsCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:ProductsViewModel}}"/>
            <Button Style="{StaticResource SidebarButton}" Content="Категорії" Command="{Binding NavigateCategoriesCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:CategoriesViewModel}}"/>
            <Button Style="{StaticResource SidebarButton}" Content="Постачальники" Command="{Binding NavigateSuppliersCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:SuppliersViewModel}}"/>
            <Button Style="{StaticResource SidebarButton}" Content="Накладні" Command="{Binding NavigateMovementsCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:StockMovementsViewModel}}"/>
            <Button Style="{StaticResource SidebarButton}" Content="Залишки" Command="{Binding NavigateStockCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:StockBalancesViewModel}}"/>
            <Button Style="{StaticResource SidebarButton}" Content="Склади" Command="{Binding NavigateWarehousesCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:WarehousesViewModel}}"/>
            <Button Style="{StaticResource SidebarButton}" Content="Звітність" Command="{Binding NavigateReportsCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:ReportsViewModel}}"/>
            <Button Style="{StaticResource SidebarButton}" Content="Користувачі"
                    Command="{Binding NavigateUsersCommand}"
                    Tag="{Binding Navigation.CurrentView, Converter={StaticResource ActiveSectionConverter}, ConverterParameter={x:Type vm:UsersViewModel}}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" Padding="0">
            <ContentControl Content="{Binding Navigation.CurrentView}"/>
        </Border>
    </Grid>
</Window>
