<UserControl x:Class="StockFlow.UI.Views.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StockFlow.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WarehousesViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Склади" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="Назва:" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0" />
            <TextBox Width="200"
                     Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddWarehouseCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="Адреса:" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" Margin="16,0,8,0" />
            <TextBox Width="240"
                     Text="{Binding NewWarehouseAddress, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddWarehouseCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="+ Додати склад"
                    Command="{Binding AddWarehouseCommand}"
                    Padding="12,4"
                    Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Warehouses}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Адреса" Binding="{Binding Address}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4"
                   Text="* Додавання складів доступне лише ролі Адмін"
                   FontStyle="Italic"
                   FontSize="11"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="0,8,0,0" />
    </Grid>
</UserControl>
