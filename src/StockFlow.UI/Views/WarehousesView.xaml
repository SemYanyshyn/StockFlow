<UserControl x:Class="StockFlow.UI.Views.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StockFlow.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WarehousesViewModel}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
  </UserControl.Resources>

  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageHeader}">
      <TextBlock Text="StockFlow — Склади" Style="{StaticResource PageHeaderText}"/>
    </Border>

    <Grid Grid.Row="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Панель пошуку, фільтрації за локацією та додавання -->
      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 Style="{StaticResource SearchBox}"
                 Tag="Пошук за назвою..."
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <ComboBox Grid.Column="2"
                  Style="{StaticResource InputComboBox}"
                  Tag="Локація:"
                  ItemsSource="{Binding Locations}"
                  SelectedItem="{Binding SelectedLocation}"/>

        <Button Grid.Column="4"
                Style="{StaticResource PrimaryButton}"
                Content="+ Додати"
                Command="{Binding OpenCreateFormCommand}"
                Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibility}}"/>
      </Grid>

      <!-- Повідомлення про помилку (наприклад, при спробі видалити склад із залишками) -->
      <TextBlock Grid.Row="1"
                 Text="{Binding ErrorMessage}"
                 Foreground="{StaticResource ErrorTextBrush}"
                 Margin="0,0,0,12">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- Таблиця складів -->
      <DataGrid Grid.Row="2"
                Style="{StaticResource ListDataGrid}"
                ItemsSource="{Binding FilteredWarehouses}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}"/>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <DataGridTextColumn Header="Назва"
                              Binding="{Binding Name}"
                              Width="1.2*"/>

          <DataGridTextColumn Header="Адреса / Місто"
                              Binding="{Binding Address}"
                              Width="1.8*"/>

          <DataGridTemplateColumn Width="200">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="Дії"
                         Width="168" TextAlignment="Right"
                         Foreground="#B86B11"
                         FontWeight="SemiBold"/>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibility}}">
                  <Button Content="Редагувати"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="4,2"
                          Cursor="Hand"
                          Foreground="#B86B11"
                          FontWeight="Medium"
                          Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"/>
                  <TextBlock Text=" · "
                             Foreground="#B86B11"
                             VerticalAlignment="Center"/>
                  <Button Content="Видалити"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="4,2"
                          Cursor="Hand"
                          Foreground="#B86B11"
                          FontWeight="Medium"
                          Command="{Binding DataContext.DeleteWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <!-- Модальне вікно додавання / редагування складу -->
    <Grid Grid.RowSpan="2"
          Background="#66000000"
          Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Background="White"
              CornerRadius="8"
              Padding="24"
              Width="440"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding FormTitle}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Margin="0,0,0,16"/>

          <TextBlock Text="Назва складу *"
                     FontSize="13"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Margin="0,0,0,4"/>
          <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                   Height="38"
                   Padding="10,8"
                   Margin="0,0,0,12"/>

          <TextBlock Text="Адреса / Місто"
                     FontSize="13"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Margin="0,0,0,4"/>
          <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                   Height="38"
                   Padding="10,8"
                   Margin="0,0,0,12"/>

          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="{StaticResource ErrorTextBrush}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}"
                    Content="Скасувати"
                    Command="{Binding CancelFormCommand}"
                    Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Зберегти"
                    Command="{Binding SaveWarehouseCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>