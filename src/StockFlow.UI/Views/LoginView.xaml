<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StockFlow.UI.Views.LoginView"
    Title="StockFlow — Вхід"
    Width="900"
    Height="690"
    MinWidth="540"
    MinHeight="570"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource PanelBackgroundBrush}"
    FontFamily="Segoe UI"
    Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PageHeader}">
            <TextBlock Text="StockFlow — Вхід" Style="{StaticResource PageHeaderText}"/>
        </Border>
        <ScrollViewer Grid.Row="1"
            VerticalContentAlignment="Center"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MaxWidth="440"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Padding="48,28">
                    <StackPanel>
                        <TextBlock Text="StockFlow" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Система складського обліку"
                            FontSize="14"
                            Margin="0,12,0,30"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"/>
                        <TextBlock Text="Логін" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,22">
                            <TextBox x:Name="UsernameInput"
                                Style="{StaticResource InputBox}"
                                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="50"
                                AutomationProperties.Name="Логін"/>
                            <TextBlock Text="Введіть логін"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=UsernameInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="Пароль" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <PasswordBox x:Name="Password"
                                Style="{StaticResource DirectoryPasswordBox}"
                                MaxLength="1024"
                                Padding="10,0,40,0"
                                AutomationProperties.Name="Пароль"/>
                            <TextBox x:Name="RevealedPassword"
                                Style="{StaticResource InputBox}"
                                MaxLength="1024"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Пароль (видимий)"/>
                            <ToggleButton x:Name="RevealToggle"
                                Width="34"
                                HorizontalAlignment="Right"
                                Margin="3"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Checked="OnRevealPassword"
                                Unchecked="OnHidePassword"
                                ToolTip="Показати або приховати пароль"
                                AutomationProperties.Name="Показати пароль">
                                <TextBlock Text="&#xE890;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Foreground="{StaticResource SecondaryTextBrush}"/>
                            </ToggleButton>
                        </Grid>
                        <Button Content="Увійти"
                            IsDefault="True"
                            Click="OnLogin"
                            Margin="0"
                            Height="44"
                            Foreground="{StaticResource PrimaryTextBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="Зачекайте, виконується вхід…"
                            FontSize="12"
                            Margin="0,12,0,0"
                            Foreground="{StaticResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ErrorMessage}"
                            Foreground="{StaticResource ErrorTextBrush}"
                            TextWrapping="Wrap"
                            Margin="0,12,0,0"
                            AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="1"
                    Text="Після входу відкривається меню відповідно до ролі користувача."
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="0,20,0,0"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
